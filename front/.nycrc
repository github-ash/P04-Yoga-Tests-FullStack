{
  "extends": "@istanbuljs/nyc-config-typescript",
  "all": true,
  "include": ["src/app/**/*.ts"],
  "report-dir": "coverage/e2e",
  "reporter": ["html", "lcov", "text-summary", "json-summary"],
  "check-coverage": true,
  "statements": 80,
  "branches": 80,
  "functions": 80,
  "lines": 80,
  "exclude": [
    "./coverage/**",
    "cypress/**",
    "./dist/**",
    "**/*.spec.ts",
    "./src/main.ts",
    "./src/test.ts",
    "**/*.conf.js"
  ]
}
